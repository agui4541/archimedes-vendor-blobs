# Local extraction output is never committed by default.
# The repository's proprietary/ directory is explicitly tracked once files
# have a reviewed source record.
*.img
# Firmware blobs may legitimately use .bin; sensitive partitions are blocked
# by the extraction manifest and CI checks instead of a filename-only ignore.
*.edb
*.muxz
*.nvram
*.nvdata
*.qcn
*.logcat
*.pcap
metadata/local-*
__pycache__/
*.pyc
